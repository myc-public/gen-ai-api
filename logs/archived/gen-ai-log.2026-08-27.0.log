/**
 * Handles HTTP POST requests to generate JavaDoc comments for provided code or a descriptive request.
 * This method acts as an endpoint that forwards the user's message to an AI chat client
 * configured with a system prompt to generate JavaDocs.
 *
 * @param message The input string containing the Java code or a descriptive request for which
 *                JavaDoc comments are to be generated by the AI. This typically represents the content
 *                that needs documentation.
 * @return A {@link ChatClientResponse} object encapsulating the AI's reply, which should contain
 *         the generated JavaDoc comments or other relevant information from the AI.
 */
    @PostMapping("/generate-java-docs")
    public ChatClientResponse generateJavaDocs(@RequestBody String message) {

        ChatClientResponse response = chatClient.prompt()
                .user(message)
                .system(SYSTEM_PROMPT)
                .call()
                .chatClientResponse();
        log.info("JavaDoc generation response: {}", response.toString());
        return response;
    }
