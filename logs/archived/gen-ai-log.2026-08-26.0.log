/**
 * Handles POST requests to generate JavaDoc comments for the given input message.
 * This method interacts with a chat client to process the input and generate JavaDoc comments.
 *
 * @param message the input message containing code for which JavaDoc comments need to be generated.
 * @return a {@link ChatClientResponse} containing the generated JavaDoc comments.
 */
@PostMapping("/generate-java-docs")
public ChatClientResponse generateJavaDocs(@RequestBody String message) {
    ChatClientResponse response = chatClient.prompt()
            .user(message)
            .system(SYSTEM_PROMPT)
            .call()
            .chatClientResponse();
    log.info("JavaDoc generation response: {}", response.toString());
    return response;
}
