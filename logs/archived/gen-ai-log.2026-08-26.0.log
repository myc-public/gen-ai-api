import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * Classe pour résoudre le problème de recherche d'éléments en O(1) en utilisant une HashMap.
 */
public class ElementFinder {

    /**
     * Méthode pour créer une HashMap avec les éléments et leurs indices.
     *
     * @param items la liste d'éléments à traiter
     * @return une HashMap avec les éléments comme clés et leurs indices comme valeurs
     */
    public static Map<Object, Integer> solve(List<Object> items) {
        Map<Object, Integer> itemIndexMap = new HashMap<>();
        for (int i = 0; i < items.size(); i++) {
            itemIndexMap.put(items.get(i), i);
        }
        return itemIndexMap;
    }

    /**
     * Méthode principale pour tester la classe.
     *
     * @param args les arguments de la ligne de commande (non utilisés)
     */
    public static void main(String[] args) {
        List<String> items = List.of("apple", "banana", "cherry");
        Map<String, Integer> itemIndexMap = solve(items);
        System.out.println("Item Index Map: " + itemIndexMap);
    }
}
