import java.util.HashMap;
import java.util.List;

public class ItemLookup {

    /**
     * Solves the problem of finding an item in a list with O(1) lookup time by using a HashMap.
     *
     * @param items The list of items to search through.
     * @return A HashMap where keys are the items and values are their indices in the original list.
     */
    public static <T> HashMap<T, Integer> solve(List<T> items) {
        HashMap<T, Integer> lookup = new HashMap<>();
        for (int i = 0; i < items.size(); i++) {
            lookup.put(items.get(i), i);
        }
        return lookup;
    }

    public static void main(String[] args) {
        List<String> items = List.of("apple", "banana", "cherry");
        HashMap<String, Integer> lookup = solve(items);
        
        System.out.println("Lookup table: " + lookup);
        // Output: Lookup table: {apple=0, banana=1, cherry=2}
        
        String targetItem = "banana";
        if (lookup.containsKey(targetItem)) {
            int index = lookup.get(targetItem);
            System.out.println("Found '" + targetItem + "' at index: " + index);
            // Output: Found 'banana' at index: 1
        } else {
            System.out.println("'" + targetItem + "' not found.");
        }
    }
}
```

