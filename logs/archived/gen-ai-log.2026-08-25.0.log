/**
 * Handles POST requests for generating JavaDoc comments based on input criteria.
 * This method interacts with a chat client to generate JavaDoc content.
 *
 * @param message The input string message that contains information 
 *                used to generate JavaDoc comments. It must be provided in the
 *                request body.
 * @return A {@link ChatClientResponse} object containing the generated JavaDoc.
 * @throws SomeSpecificException If an error occurs during the chat client call.
 *         (Note: Replace SomeSpecificException with the actual exception class if applicable)
 */
@PostMapping("/generate-java-docs")
public ChatClientResponse generateJavaDocs(@RequestBody String message) {
    ChatClientResponse response = chatClient.prompt()
            .user(message)
            .system(SYSTEM_PROMPT)
            .call()
            .chatClientResponse();
    log.info("JavaDoc generation response: {}", response.toString());
    return response;
}
