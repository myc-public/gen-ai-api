    /**
     * Handles a POST request to generate JavaDoc comments for a given input message using a chat client.
     * This endpoint receives a message containing code or a request for JavaDocs, forwards it to a configured
     * chat client, and returns the client's response.
     *
     * @param message The input string (e.g., code snippet, request) for which JavaDocs are to be generated.
     *                This is extracted from the request body.
     * @return A {@link ChatClientResponse} object containing the response from the chat client,
     *         which typically includes the generated JavaDocs or a related message.
     * @throws org.springframework.web.client.RestClientException (or similar) if the underlying chat client
     *         fails to communicate with its service or encounters an error during the prompt execution.
     */
    @PostMapping("/generate-java-docs")
    public ChatClientResponse generateJavaDocs(@RequestBody String message) {

        ChatClientResponse response = chatClient.prompt()
                .user(message)
                .system(SYSTEM_PROMPT)
                .call()
                .chatClientResponse();
        log.info("JavaDoc generation response: {}", response.toString());
        return response;
    }
